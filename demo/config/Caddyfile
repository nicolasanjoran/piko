{
    # Enable on-demand TLS with Piko validation
    # Caddy will call this endpoint to check if a domain is allowed for TLS
    on_demand_tls {
        ask http://localhost:8002/caddy/check-domain
        interval 2m
        burst 5
    }
    
    # For local testing, use local certificates (optional)
    # Remove this in production to use Let's Encrypt
    # local_certs
    
    # Optional: Use Let's Encrypt staging for testing (to avoid rate limits)
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Fixed HTTPS endpoint for upstream connections (port 8001)
# Agents connect to this port to register endpoints
upstream.piko.localhost:8443 {
    tls {
        # Use a fixed certificate for the upstream endpoint
        # You can generate a self-signed cert or use Let's Encrypt
    }
    
    reverse_proxy http://localhost:8001 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
    }
}

# Catch-all for dynamic HTTPS domains (port 443)
# This handles all incoming requests and routes them to Piko
:443 {
    tls {
        on_demand
    }
    
    # Forward to Piko proxy server, preserving the Host header
    reverse_proxy http://localhost:8000 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote}
    }
}

# Redirect HTTP to HTTPS
:80 {
    redir https://{host}{uri} permanent
}

